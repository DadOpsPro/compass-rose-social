{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compassrose.local/silent-reel.schema.json",
  "title": "Compass Rose silent Reel timeline",
  "type": "object",
  "required": ["scenes"],
  "additionalProperties": true,
  "properties": {
    "comment": { "type": "string" },
    "width": { "type": "integer", "default": 1080 },
    "height": { "type": "integer", "default": 1920 },
    "fps": { "type": "integer", "default": 30, "minimum": 1, "maximum": 120 },
    "font": {
      "type": "string",
      "enum": ["montserrat", "bebas", "oswald", "playfair", "poppins", "anton"],
      "default": "montserrat",
      "description": "Typeface for every beat in this Reel. Omit for Montserrat ExtraBold. Production timelines must set this only at the root — never per scene (one type system per Reel)."
    },
    "typeface": {
      "type": "string",
      "enum": ["montserrat", "bebas", "oswald", "playfair", "poppins", "anton"],
      "description": "Synonym of font. If both are set they must resolve to the same preset."
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scene" }
    }
  },
  "$defs": {
    "scene": {
      "type": "object",
      "required": ["duration", "image"],
      "properties": {
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Beat length in seconds (try 3.2–4.0 if 3s feels rushed)."
        },
        "transition": {
          "type": "object",
          "description": "Incoming transition. Ignored on scene 0. fade ~0.25–0.4s.",
          "properties": {
            "type": { "enum": ["fade", "none", "cut"] },
            "duration": { "type": "number", "minimum": 0, "default": 0.35 }
          }
        },
        "image": { "$ref": "#/$defs/image" },
        "text": { "$ref": "#/$defs/text" }
      }
    },
    "image": {
      "type": "object",
      "required": ["src"],
      "properties": {
        "src": {
          "type": "string",
          "description": "Local path (relative to this JSON), https URL, or color:#1B4F72."
        },
        "fit": { "const": "cover", "default": "cover" },
        "zoom": {
          "type": "number",
          "minimum": 1,
          "maximum": 1.4,
          "default": 1,
          "description": "End scale. 1 = still. Subtle Ken Burns is 1.05–1.12. Not JSON2Video's 1–3 intensity."
        },
        "pan": {
          "enum": ["left", "right", "top", "bottom", "center"],
          "default": "center"
        }
      }
    },
    "text": {
      "type": "object",
      "required": ["content"],
      "properties": {
        "content": { "type": "string", "description": "Use \\n for line breaks." },
        "position": { "enum": ["lower-third", "center", "top"], "default": "lower-third" },
        "fontSize": { "type": "number", "default": 64, "description": "Pixel size. Typeface is timeline.font, not a per-scene field." },
        "color": { "type": "string", "default": "#FFFFFF" },
        "background": {
          "type": "string",
          "default": "rgba(0,0,0,0.45)",
          "description": "CSS color, or none to disable the dark bar."
        }
      }
    }
  }
}
