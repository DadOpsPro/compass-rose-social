# Copy to web/.env.local (never commit real values).

# Shared password for the Kristin editor. If unset, the UI is open locally.
# On Vercel, set this OR use Vercel Deployment Protection.
EDITOR_PASSWORD=

# Fire GitHub Actions repository_dispatch (event: render-reel).
# Fine-grained PAT needs Actions: write on this repo. Classic PAT needs `repo`.
# Name may be RENDER_DISPATCH_TOKEN or GITHUB_TOKEN.
RENDER_DISPATCH_TOKEN=
GITHUB_REPOSITORY=DadOpsPro/compass-rose-social

# Optional public MP4 URL shown in the editor preview player.
PREVIEW_VIDEO_URL=
